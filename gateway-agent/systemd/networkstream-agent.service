[Unit]
Description=NetworkStream Gateway Agent
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/networkstream/networkstream-agent.py --api http://127.0.0.1:8080
Restart=always
RestartSec=5
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
